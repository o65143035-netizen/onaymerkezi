{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/downloads/onay-merkezi-tum-kodlar.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/sitemap_index.xml", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/robots", "destination": "/robots.txt", "permanent": true },
    { "source": "/:slug/index.html", "destination": "/:slug", "permanent": true },
    { "source": "/5SIM-incelemesi", "destination": "/5sim-incelemesi", "permanent": true },
    { "source": "/SMSVAR-incelemesi", "destination": "/smsvar-incelemesi", "permanent": true },
    { "source": "/SMMSIM-incelemesi", "destination": "/smmsim-incelemesi", "permanent": true },
    { "source": "/WhatsApp-sanal-numara", "destination": "/whatsapp-sanal-numara", "permanent": true },
    { "source": "/Sanal-numara-nedir", "destination": "/sanal-numara-nedir", "permanent": true }
  ]
}
